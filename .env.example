# ===================================================================
# PlacementWeekScheduler Environment Configuration Template
# Copy this file to '.env' and populate with your local database credentials
# ===================================================================

# Server Port Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/placement_scheduler?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Hibernate / JPA Strategy (update, create, validate)
DDL_AUTO=update
SHOW_SQL=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
